Subject: mmc: mtk-sd: MSDC-DBG printk (temporary debug)
--- a/drivers/mmc/host/mtk-sd.c
+++ b/drivers/mmc/host/mtk-sd.c
@@ -1334,6 +1334,8 @@
 
 	writel(cmd->arg, host->base + SDC_ARG);
 	writel(rawcmd, host->base + SDC_CMD);
+	pr_info("MSDC-DBG: START cmd=%d arg=%08x rawcmd=%08x\n",
+		cmd->opcode, cmd->arg, rawcmd);
 }
 
 static void msdc_cmd_next(struct msdc_host *host,
@@ -1664,6 +1666,12 @@
 			__msdc_enable_sdio_irq(host, 0);
 		/* clear interrupts */
 		writel(events & event_mask, host->base + MSDC_INT);
+		if (events & event_mask & (MSDC_INT_CMDRDY | MSDC_INT_CMDTMO |
+				MSDC_INT_RSPCRCERR | MSDC_INT_XFER_COMPL |
+				MSDC_INT_DXFER_DONE | MSDC_INT_DATTMO |
+				MSDC_INT_DATCRCERR))
+			pr_info("MSDC-DBG: IRQ events=%08x mask=%08x\n",
+				events, event_mask);
 
 		mrq = host->mrq;
 		cmd = host->cmd;
