#!/bin/sh
# HLK-7688A first-boot setup: WiFi AP + 4G WAN (Quectel EC20 ECM) + SD f2fs.
# Only runs on this board. Config mirrors the verified 22.03.5 setup, with the
# ECM interface renamed eth1 on kernel 6.6 (was usb0 on 5.10); a hotplug script
# re-points wan at whatever the ECM interface is actually named.

[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "hilink,hlk-7688a" ] || exit 0

# --- WiFi AP: WPA2 + 稳定性优化（deep-research wtyzz0tqp：HT20 / channel / psk2）
#     14.10 WiFi 失效根因 = mt7603 驱动持续 TX bug，24.10 已修(mt76-2025.01.14)。
#     HT20(3 非重叠信道/降干扰)；channel=11 固定（auto 在 mt7603 ACS 不可靠，实测总落拥堵的 1）。---
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.country='CN'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.channel='11'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid='OpenWrt'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key='1234567*'
uci commit wireless

# --- root 统一密码（串口/SSH/LuCI；busybox 无 chpasswd → openssl passwd 生成 hash 写 shadow）---
HASH=$(openssl passwd -6 '*123654*A' 2>/dev/null)
if [ -n "$HASH" ]; then
	awk -F: -v OFS=: -v h="$HASH" '$1=="root"{$2=h} {print}' /etc/shadow > /tmp/.shadow.new
	cat /tmp/.shadow.new > /etc/shadow
	rm -f /tmp/.shadow.new
fi

# --- 串口 console 也要密码（默认 ttylogin 未设 → login.sh 走 /bin/login -f root 免密；设 1 走正常 login 要密码）---
uci set system.@system[0].ttylogin='1'
uci commit system

# --- 4G WAN on EC20 ECM (dhcp). Device defaults to eth1 (6.6 cdc_ether);
#     hotplug.d/net/20-ecm-wan corrects it if the interface is named differently. ---
# LAN br-lan IP：默认 192.168.1.1 → 192.168.8.1
uci set network.lan.ipaddr='192.168.8.1'
uci set network.wan.proto='dhcp'
uci set network.wan.device='eth1'
uci -q delete network.wan6

# port 0 改 LAN（HLK-7688A 唯一 RJ45 默认是 WAN/VLAN2；改 LAN/VLAN1 接相机/PC；
# 4G WAN 走 eth1 不受影响。遍历 switch_vlan 按 ports 内容识别 LAN/WAN）
for sv in $(uci -q show network 2>/dev/null | grep '=switch_vlan' | cut -d. -f2 | cut -d= -f1); do
	p=$(uci -q get network.$sv.ports)
	case "$p" in
		*"1 2 3 4"*) uci set network.$sv.ports='0 1 2 3 4 6t' ;;   # LAN VLAN 加 port 0
		*"0 6t"*)    uci set network.$sv.ports='6t' ;;              # WAN VLAN 去 port 0（eth0.2 无物理口，闲置）
	esac
done
uci commit network

# --- OpenVPN tun0 firewall zone（让 VPN 主机能 SSH/ping gateway 的 tun0 IP）---
# tun0 默认不在任何 firewall zone，入站被 REJECT；建 vpn zone input ACCEPT
uci -q delete firewall.vpn 2>/dev/null
uci set firewall.vpn='zone'
uci set firewall.vpn.name='vpn'
uci set firewall.vpn.input='ACCEPT'
uci set firewall.vpn.output='ACCEPT'
uci set firewall.vpn.forward='ACCEPT'
uci add_list firewall.vpn.device='tun0'
# vpn → lan forwarding：让 VPN 主机直接访问 LAN 摄像机（192.168.8.x，网页/RTSP/录像全端口）
uci -q delete firewall.vpn_lan 2>/dev/null
uci set firewall.vpn_lan='forwarding'
uci set firewall.vpn_lan.src='vpn'
uci set firewall.vpn_lan.dest='lan'

# uhttpd 监听改 :1234（LuCI 释放 :80；局域网+VPN 都用 :1234 访问 LuCI）
uci -q delete uhttpd.main.listen_http
uci add_list uhttpd.main.listen_http='0.0.0.0:1234'
uci commit uhttpd

# 端口映射（局域网 + VPN 一致：gateway:80 = 车牌相机，gateway:1234 = LuCI）
# 车牌相机网页：:80 → 192.168.8.222:80（lan + vpn 都映射）
uci -q delete firewall.cam_lpr_lan 2>/dev/null
uci set firewall.cam_lpr_lan='redirect'
uci set firewall.cam_lpr_lan.name='车牌相机网页(lan)'
uci set firewall.cam_lpr_lan.src='lan'
uci set firewall.cam_lpr_lan.src_dport='80'
uci set firewall.cam_lpr_lan.dest='lan'
uci set firewall.cam_lpr_lan.dest_ip='192.168.8.222'
uci set firewall.cam_lpr_lan.dest_port='80'
uci set firewall.cam_lpr_lan.proto='tcp'
uci set firewall.cam_lpr_lan.target='DNAT'
uci -q delete firewall.cam_lpr_vpn 2>/dev/null
uci set firewall.cam_lpr_vpn='redirect'
uci set firewall.cam_lpr_vpn.name='车牌相机网页(vpn)'
uci set firewall.cam_lpr_vpn.src='vpn'
uci set firewall.cam_lpr_vpn.src_dport='80'
uci set firewall.cam_lpr_vpn.dest='lan'
uci set firewall.cam_lpr_vpn.dest_ip='192.168.8.222'
uci set firewall.cam_lpr_vpn.dest_port='80'
uci set firewall.cam_lpr_vpn.proto='tcp'
uci set firewall.cam_lpr_vpn.target='DNAT'
# 球机网页：:221 → 192.168.8.221:80（VPN；局域网直接 8.221:80）
uci -q delete firewall.cam_dome 2>/dev/null
uci set firewall.cam_dome='redirect'
uci set firewall.cam_dome.name='球机网页'
uci set firewall.cam_dome.src='vpn'
uci set firewall.cam_dome.src_dport='221'
uci set firewall.cam_dome.dest='lan'
uci set firewall.cam_dome.dest_ip='192.168.8.221'
uci set firewall.cam_dome.dest_port='80'
uci set firewall.cam_dome.proto='tcp'
uci set firewall.cam_dome.target='DNAT'
uci commit firewall

# --- SD card: 不自动挂载，让 gateway app 自己 mount /mnt/mmcblk0p1（f2fs）---
# app MountProcess system("mount /dev/mmcblk0p1 /mnt/mmcblk0p1") 自动检测 f2fs
# OpenWrt 自动挂 /mnt/sd 会占用设备，导致 app mount 失败 → 最简程序退出
mkdir -p /mnt/mmcblk0p1

# --- 时区 CST（UTC+8，Asia/Shanghai）---
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system

# --- 系统版本（gateway app GetSystemVersion 从此文件读 "Release" 字符串上报 MQTT LOGIN）---
echo 'Release_24.10.0_r28427-6df0e3d02a' > /etc/config/sys_version

# --- crontab：gateway app 守护（dec.bin 每分钟）+ NTP 同步（每 10 分钟阿里云）---
# sysntpd 固件默认 disabled 不冲突；busybox crond 默认 disabled 需手动 enable
# monitor（C 二进制）注释——未移植 24.10(uClibc→musl)，待移植后取消注释
mkdir -p /etc/crontabs
cat > /etc/crontabs/root << 'CRONEOF'
*/2 * * * * monitor
* * * * * /home/bump_detect/dec.bin
*/10 * * * * ntpd -gq -p ntp.aliyun.com
CRONEOF
/etc/init.d/cron enable
/etc/init.d/cron start

exit 0
