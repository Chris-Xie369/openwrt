# iKuai OpenVPN client（兼容 14.10 老服务器：BF-CBC + TLS 1.0，服务器端不变）
# 由 /usr/bin/gw-vpn 启动（从 /opt/data/params.json 提 SN 生成 /home/config/vpn_login.conf）
client
dev tun
proto tcp
tun-mtu 1400
remote 58.210.34.82 2023
resolv-retry infinite
nobind
persist-key
persist-tun
verb 3
auth-user-pass /home/config/vpn_login.conf
script-security 2

# OpenVPN 2.6 兼容老 iKuai（BF-CBC 数据加密 + TLS 1.0 控制通道）
data-ciphers BF-CBC
data-ciphers-fallback BF-CBC
comp-lzo
tls-cipher "DEFAULT:@SECLEVEL=0"

